{
  "name": "bot",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n BACK,FRONT -c blue,green \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "nodemon --watch src --exec ts-node src/server.ts",
    "dev:front": "npm run dev --prefix painel",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.16",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}